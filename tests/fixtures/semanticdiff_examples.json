            "const crypto = require('crypto');",
            "const fs = require('fs');",
            "const path = require('path');",
            "",
            "function calc_hash(file_path) {",
            "    const hash = crypto.createHash('sha256');",
            "    const bytes = fs.readFileSync(file_path, {flag: 'r'});",
            "    hash.write(bytes);",
            "",
            "    return hash;",
            "}",
            "",
            "function print_hashes(dir) {",
            "    for (const file of fs.readdirSync(dir)) {",
            "        const file_path = path.join(dir, file); ",
            "",
            "        if (!fs.lstatSync(file_path).isFile())",
            "            continue;",
            "",
            "        hash = calc_hash(file_path);",
            "        console.log(`${hash.digest('hex')} ${file}`);",
            "    }",
            "}",
            "",
            "print_hashes(\".\");"
          ]
        },
